# gemini-enterprise SCA Remediation agent -- local dev environment (§11).
# Copy to `.env` for local runs. Real secrets belong only in GCP Secret Manager,
# never in this file or the repo.

# --- Client selection ---------------------------------------------------------
# v1 / build-order step 2 runs entirely on mocked findings.
# Set to "rest" once the direct Endor REST client (build-order step 3) lands.
ENDOR_CLIENT=mock

# --- Endor Labs data client (used when ENDOR_CLIENT=rest) ----------------------
ENDOR_API_BASE_URL=https://api.endorlabs.com
# Service credential the agent uses to call the Endor REST API on behalf of the
# authenticated tenant. Placeholder only -- load from Secret Manager in deploys.
ENDOR_API_SERVICE_CREDENTIAL=

# --- OAuth / IdP (build-order step 4) -----------------------------------------
OAUTH_AUTHORIZATION_URL=https://auth.endorlabs.com/oauth/authorize
OAUTH_TOKEN_URL=https://auth.endorlabs.com/oauth/token
# Google's JWKS endpoint for validating DCR software_statement JWTs (fetch live).
GOOGLE_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs

# --- Procurement / Firestore (build-order step 5) -----------------------------
FIRESTORE_PROJECT_ID=marketplace-458521
PUBSUB_SUBSCRIPTION_NAME=
PARTNER_PROCUREMENT_API_ENDPOINT=https://cloudcommerceprocurement.googleapis.com
