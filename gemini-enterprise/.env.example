# gemini-enterprise SCA Remediation agent -- local dev environment (§11).
# Copy to `.env` for local runs. Real secrets belong only in GCP Secret Manager,
# never in this file or the repo.

# --- Client selection ---------------------------------------------------------
# "mock" runs entirely on deterministic mocked findings (default).
# "rest" uses the direct Endor REST client (build-order step 3).
ENDOR_CLIENT=mock

# --- Endor Labs data client (used when ENDOR_CLIENT=rest) ----------------------
ENDOR_API_BASE_URL=https://api.endorlabs.com
# Service credential pair the agent uses to call the Endor REST API on behalf
# of the authenticated tenant (§11's ENDOR_API_SERVICE_CREDENTIAL, realized as
# an api key + secret). Placeholders only -- load from Secret Manager in deploys.
ENDOR_API_CREDENTIALS_KEY=
ENDOR_API_CREDENTIALS_SECRET=
# Optional: default namespace when the caller/tenant does not supply one.
ENDOR_NAMESPACE=
# Optional, local dev only: set to 1 to let the service fall back to
# ~/.endorctl/config.yaml for the key/secret/namespace above.
# ENDOR_ALLOW_ENDORCTL_CONFIG=1

# --- OAuth / IdP (build-order step 4) -----------------------------------------
OAUTH_AUTHORIZATION_URL=https://auth.endorlabs.com/oauth/authorize
OAUTH_TOKEN_URL=https://auth.endorlabs.com/oauth/token
# Google's JWKS endpoint for validating DCR software_statement JWTs (fetch live).
GOOGLE_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs

# --- Procurement / Firestore (build-order step 5) -----------------------------
FIRESTORE_PROJECT_ID=<your-gcp-project-id>
PUBSUB_SUBSCRIPTION_NAME=
PARTNER_PROCUREMENT_API_ENDPOINT=https://cloudcommerceprocurement.googleapis.com
