{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "bash \"${PLUGIN_ROOT:-.}/hooks/check-manifest-edit.sh\" PostToolUse",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content"
      }
    ],
    "PreInvocation": [
      {
        "command": "bash \"${PLUGIN_ROOT:-.}/hooks/suggest-endor-tools.sh\" PreInvocation",
        "timeout": 10,
        "type": "command"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "bash \"${PLUGIN_ROOT:-.}/hooks/enforce-agent-api.sh\" PreToolUse",
            "timeout": 10,
            "type": "command"
          },
          {
            "command": "bash \"${PLUGIN_ROOT:-.}/hooks/check-dep-install.sh\" PreToolUse",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "run_command"
      }
    ]
  }
}
